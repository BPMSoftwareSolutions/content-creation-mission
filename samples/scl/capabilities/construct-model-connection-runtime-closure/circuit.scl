  capability "construct-model-connection-runtime-closure" {
    label "Construct model connection runtime closures";
    domain "Frozen source corpus";
    scenarioIds ["construct-model-connection-runtime-closure", "classify-model-connection-external-substrates", "reject-sibling-repository-runtime-dependency", "reject-unsafe-runtime-path", "reject-runtime-source-loader-dependency", "reject-undeclared-or-mutable-runtime-package", "reject-incomplete-runtime-artifact-set", "reject-runtime-digest-drift", "reject-incomplete-model-connection-host-coverage"];
