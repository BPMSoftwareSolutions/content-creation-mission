    sourceRefs ["src-00000"];
  }
  scenario "construct-model-connection-runtime-closure" {
    capabilityId "construct-model-connection-runtime-closure";
    label "Construct one complete self-contained projected runtime closure";
    nodeIds ["s0-input", "s0-event", "s0-outcome"];
    sourceRefs ["src-00029", "src-00030"];
  }
  scenario "classify-model-connection-external-substrates" {
    capabilityId "construct-model-connection-runtime-closure";
    label "Distinguish projected artifacts from irreducible host substrates";
