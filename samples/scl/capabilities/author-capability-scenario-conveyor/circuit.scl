  capability "author-capability-scenario-conveyor" {
    label "Author a capability through a scenario-scoped conveyor";
    domain "Frozen source corpus";
    scenarioIds ["author-capability-scenario-conveyor", "initialize-capability-scenario-authoring-ledger", "reject-invalid-capability-scenario-authoring-source", "author-single-scenario-capability-through-conveyor", "select-root-capability-scenario-first", "select-next-eligible-capability-scenario", "hold-capability-scenario-selection-with-no-eligible-unit", "retain-conveyed-route-state", "resolve-authorized-scenario-continuation", "invoke-authorized-scenario-invocation-set", "construct-bounded-scenario-authoring-request", "reject-scenario-authoring-context-scope-expansion", "obtain-one-scenario-authority-fragment-testimony", "retain-unsuccessful-scenario-authoring-attempt", "switch-scenario-author-model-after-declared-failure", "inspect-one-scenario-authority-fragment", "reject-cross-scenario-or-whole-capability-testimony", "curate-bounded-scenario-authority-fragment-defect", "require-new-scenario-attempt-for-broadly-unusable-fragment", "admit-one-scenario-authority-fragment", "reject-scenario-fragment-conflicting-with-admitted-authority", "integrate-admitted-scenario-authority-fragment", "reject-unadmitted-duplicate-stale-or-out-of-order-fragment-integration", "resume-capability-scenario-authoring-conveyor", "stop-capability-scenario-authoring-on-budget-cancellation-or-rejection", "assemble-closed-capability-source-bundle-from-scenario-fragments", "reject-premature-or-incomplete-capability-authoring-closure", "preserve-capability-scenario-authoring-deterministic-replay", "preserve-stable-capability-authoring-user-experience", "hand-off-closed-capability-bundle-for-independent-projection"];
    coverage "30 declared scenarios; native detail remains separately inspectable";
    sourceRefs ["src-00000"];
  }
  scenario "author-capability-scenario-conveyor" {
    capabilityId "author-capability-scenario-conveyor";
    label "Author one complete capability by advancing through one scenario at a time";
    nodeIds ["s0-input", "s0-event", "s0-outcome"];
    sourceRefs ["src-00686", "src-00687"];
  }
  scenario "initialize-capability-scenario-authoring-ledger" {
    capabilityId "author-capability-scenario-conveyor";
    label "Freeze the capability shell and complete scenario ledger before model use";
    nodeIds ["s1-input", "s1-event", "s1-outcome"];
    sourceRefs ["src-00688", "src-00689"];
  }
  scenario "reject-invalid-capability-scenario-authoring-source" {
    capabilityId "author-capability-scenario-conveyor";
    label "Reject an incomplete ambiguous or unsupported feature before authoring";
    nodeIds ["s2-input", "s2-event", "s2-outcome"];
    sourceRefs ["src-00690", "src-00691"];
  }
  scenario "author-single-scenario-capability-through-conveyor" {
    capabilityId "author-capability-scenario-conveyor";
    label "Complete a single-scenario capability without inventing transitions";
    nodeIds ["s3-input", "s3-event", "s3-outcome"];
    sourceRefs ["src-00692", "src-00693"];
  }
  scenario "select-root-capability-scenario-first" {
