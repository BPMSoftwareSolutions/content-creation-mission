  title "Project Consumer Execution Embodiment V2";
  promise "{\"experienceType\": \"promised-experience.v1\", \"experienceId\": \"consumer-execution-embodiment-v2-is-projectable\", \"actor\": \"SDA platform maintainer operating the deterministic conveyor\", \"promise\": \"The execution guarantees strict policy preservation, deterministic candidate generation, and explicit failure reporting without claiming acceptance or promotion.\", \"observableConditions\": [{\"conditionId\": \"v2-operation-kinds-are-preserved\", \"statement\": \"typed invoke-port and invoke-scenario operations remain distinct in every target candidate\"}, {\"conditionId\": \"composition-policy-is-preserved\", \"statement\": \"carrier, intermediate-contract, lineage, first-failure, and recursion policies remain immutable\"}, {\"conditionId\": \"target-origin-is-projected-only\", \"statement\": \"Node, C#, and Python executable artifacts may originate only from admitted projection authority\"}, {\"conditionId\": \"fixture-observation-is-attributable\", \"statement\": \"all eight fixture partitions return exact target dispositions and findings\"}, {\"conditionId\": \"acceptance-is-external\", \"statement\": \"candidate generation and observation make no acceptance or promotion claim\"}]}";
