  capability "bind-external-credential-reference" {
    label "Bind external credential references";
    domain "Frozen source corpus";
    scenarioIds ["bind-external-credential-reference", "hold-missing-or-empty-external-credential", "reject-unauthorized-external-credential-reference", "reject-mismatched-credential-invocation-identity", "reject-stale-or-replayed-credential-binding", "reject-embedded-credential-material", "prove-external-credential-non-disclosure"];
    coverage "7 declared scenarios; native detail remains separately inspectable";
    sourceRefs ["src-00000"];
  }
  scenario "bind-external-credential-reference" {
    capabilityId "bind-external-credential-reference";
    label "Bind one authorized credential reference for one invocation";
    nodeIds ["s0-input", "s0-event", "s0-outcome"];
    sourceRefs ["src-00018", "src-00019"];
  }
  scenario "hold-missing-or-empty-external-credential" {
    capabilityId "bind-external-credential-reference";
    label "Hold a missing or empty credential without external effects";
    nodeIds ["s1-input", "s1-event", "s1-outcome"];
    sourceRefs ["src-00020", "src-00021"];
  }
  scenario "reject-unauthorized-external-credential-reference" {
    capabilityId "bind-external-credential-reference";
    label "Reject a credential name outside admitted authority";
    nodeIds ["s2-input", "s2-event", "s2-outcome"];
    sourceRefs ["src-00022", "src-00023"];
  }
  scenario "reject-mismatched-credential-invocation-identity" {
    capabilityId "bind-external-credential-reference";
    label "Reject a credential reference bound for another invocation";
    nodeIds ["s3-input", "s3-event", "s3-outcome"];
    sourceRefs ["src-00024", "src-00025"];
  }
  scenario "reject-stale-or-replayed-credential-binding" {
    capabilityId "bind-external-credential-reference";
    label "Reject expired consumed or replayed opaque bindings";
    nodeIds ["s4-input", "s4-event", "s4-outcome"];
    sourceRefs ["src-00026", "src-00027"];
  }
  scenario "reject-embedded-credential-material" {
    capabilityId "bind-external-credential-reference";
    label "Reject credential values crossing the semantic boundary";
    nodeIds ["s5-input", "s5-event", "s5-outcome"];
    sourceRefs ["src-00028", "src-00029"];
  }
  scenario "prove-external-credential-non-disclosure" {
    capabilityId "bind-external-credential-reference";
    label "Prove credential values are absent from every observable artifact";
    nodeIds ["s6-input", "s6-event", "s6-outcome"];
    sourceRefs ["src-00030", "src-00031"];
  }
  input "s0-input" {
    label "external credential binding request";
    detail "one admitted credential reference name, matching invocation identity, authorized credential effect provider, and available non-empty credential";
    capabilityId "bind-external-credential-reference";
    scenarioId "bind-external-credential-reference";
    basis "DECLARED";
    sourceRefs ["src-00018", "src-00019"];
    layer "mechanic";
    productContract "bind-external-credential-reference-input.v1";
  }
  event "s0-event" {
    label "external credential reference binding requested";
    detail "the external credential reference is bound";
    capabilityId "bind-external-credential-reference";
    scenarioId "bind-external-credential-reference";
    basis "DECLARED";
    sourceRefs ["src-00018", "src-00019"];
    layer "mechanic";
  }
  outcome "s0-outcome" {
    label "external credential binding";
    detail "an opaque invocation-scoped binding and secret-free availability lineage are returned without exposing the credential value";
    capabilityId "bind-external-credential-reference";
    scenarioId "bind-external-credential-reference";
    basis "DECLARED";
    sourceRefs ["src-00018", "src-00019"];
    layer "mechanic";
    productContract "external-credential-binding-evidence.v1";
  }
  input "s1-input" {
    label "missing or empty external credential binding request";
    detail "one authorized credential reference whose external value is absent or empty";
    capabilityId "bind-external-credential-reference";
    scenarioId "hold-missing-or-empty-external-credential";
    basis "DECLARED";
    sourceRefs ["src-00020", "src-00021"];
    layer "mechanic";
    productContract "bind-external-credential-reference-input.v1";
  }
  event "s1-event" {
    label "missing or empty external credential binding requested";
    detail "the reference is bound";
    capabilityId "bind-external-credential-reference";
    scenarioId "hold-missing-or-empty-external-credential";
    basis "DECLARED";
    sourceRefs ["src-00020", "src-00021"];
    layer "mechanic";
  }
  outcome "s1-outcome" {
    label "external credential not available";
    detail "CREDENTIAL_NOT_AVAILABLE and secret-free reference lineage are returned without creating a binding, reading alternatives, or authorizing an HTTP exchange";
    capabilityId "bind-external-credential-reference";
    scenarioId "hold-missing-or-empty-external-credential";
    basis "DECLARED";
    sourceRefs ["src-00020", "src-00021"];
    layer "mechanic";
    productContract "external-credential-binding-evidence.v1";
  }
  input "s2-input" {
    label "unauthorized external credential binding request";
    detail "a request naming an undeclared credential source, variable, secret-store path, tenant, or scope";
    capabilityId "bind-external-credential-reference";
    scenarioId "reject-unauthorized-external-credential-reference";
    basis "DECLARED";
    sourceRefs ["src-00022", "src-00023"];
    layer "mechanic";
    productContract "bind-external-credential-reference-input.v1";
  }
  event "s2-event" {
    label "unauthorized external credential binding requested";
    detail "credential-reference authorization is evaluated";
    capabilityId "bind-external-credential-reference";
    scenarioId "reject-unauthorized-external-credential-reference";
    basis "DECLARED";
    sourceRefs ["src-00022", "src-00023"];
    layer "mechanic";
  }
  outcome "s2-outcome" {
    label "unauthorized external credential reference";
    detail "the unauthorized reference is rejected without attempting to read it, enumerating nearby credentials, or exposing policy-private names";
    capabilityId "bind-external-credential-reference";
    scenarioId "reject-unauthorized-external-credential-reference";
    basis "DECLARED";
    sourceRefs ["src-00022", "src-00023"];
    layer "mechanic";
    productContract "external-credential-binding-evidence.v1";
  }
  input "s3-input" {
    label "mismatched credential invocation binding request";
    detail "an admitted credential reference and an invocation identity that differs from the request, provider binding, or effect authorization";
    capabilityId "bind-external-credential-reference";
    scenarioId "reject-mismatched-credential-invocation-identity";
    basis "DECLARED";
    sourceRefs ["src-00024", "src-00025"];
    layer "mechanic";
    productContract "bind-external-credential-reference-input.v1";
  }
  event "s3-event" {
    label "mismatched credential invocation binding requested";
    detail "invocation scope is evaluated";
    capabilityId "bind-external-credential-reference";
    scenarioId "reject-mismatched-credential-invocation-identity";
    basis "DECLARED";
    sourceRefs ["src-00024", "src-00025"];
    layer "mechanic";
  }
  outcome "s3-outcome" {
    label "mismatched credential invocation rejection";
    detail "no opaque binding is returned and the exact identity mismatch is retained without reading credential bytes";
    capabilityId "bind-external-credential-reference";
    scenarioId "reject-mismatched-credential-invocation-identity";
    basis "DECLARED";
    sourceRefs ["src-00024", "src-00025"];
    layer "mechanic";
    productContract "external-credential-binding-evidence.v1";
  }
  input "s4-input" {
    label "stale or replayed external credential binding";
    detail "an opaque credential binding that is expired, already consumed, belongs to another effect, or no longer matches authority";
    capabilityId "bind-external-credential-reference";
    scenarioId "reject-stale-or-replayed-credential-binding";
    basis "DECLARED";
    sourceRefs ["src-00026", "src-00027"];
    layer "mechanic";
    productContract "bind-external-credential-reference-input.v1";
  }
  event "s4-event" {
    label "stale or replayed credential binding use requested";
    detail "the binding is presented for use";
    capabilityId "bind-external-credential-reference";
    scenarioId "reject-stale-or-replayed-credential-binding";
    basis "DECLARED";
    sourceRefs ["src-00026", "src-00027"];
    layer "mechanic";
  }
  outcome "s4-outcome" {
    label "stale or replayed credential binding rejection";
    detail "use is rejected without refreshing, copying, persisting, or re-reading credential material implicitly";
    capabilityId "bind-external-credential-reference";
    scenarioId "reject-stale-or-replayed-credential-binding";
    basis "DECLARED";
    sourceRefs ["src-00026", "src-00027"];
    layer "mechanic";
    productContract "external-credential-binding-evidence.v1";
  }
  input "s5-input" {
    label "credential bearing semantic carrier";
    detail "a scenario carrier containing an API key, token, authorization header, secret-bearing URL, or other credential value";
    capabilityId "bind-external-credential-reference";
    scenarioId "reject-embedded-credential-material";
    basis "DECLARED";
    sourceRefs ["src-00028", "src-00029"];
    layer "mechanic";
    productContract "bind-external-credential-reference-input.v1";
  }
  event "s5-event" {
    label "credential bearing semantic carrier observed";
    detail "the credential boundary is evaluated";
    capabilityId "bind-external-credential-reference";
