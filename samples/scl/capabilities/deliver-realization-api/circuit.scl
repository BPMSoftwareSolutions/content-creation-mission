  capability "deliver-realization-api" {
    label "Deliver the SideFX realization API over loopback HTTP";
    domain "Frozen source corpus";
    scenarioIds ["deliver-realization-api", "discover-realization-api-capabilities", "plan-realization-api-target", "project-realization-api-capability", "observe-realization-api-projection", "dispose-realization-api-roots"];
    coverage "6 declared scenarios; native detail remains separately inspectable";
    sourceRefs ["src-00000"];
  }
  scenario "deliver-realization-api" {
    capabilityId "deliver-realization-api";
    label "Start the admitted loopback realization API";
    nodeIds ["s0-input", "s0-event", "s0-outcome"];
    sourceRefs ["src-00020", "src-00021"];
  }
  scenario "discover-realization-api-capabilities" {
    capabilityId "deliver-realization-api";
    label "List and inspect capsules through declared GET routes";
    nodeIds ["s1-input", "s1-event", "s1-outcome"];
    sourceRefs ["src-00022", "src-00023"];
  }
  scenario "plan-realization-api-target" {
    capabilityId "deliver-realization-api";
    label "Plan a capability realization for one target profile";
    nodeIds ["s2-input", "s2-event", "s2-outcome"];
    sourceRefs ["src-00024", "src-00025"];
  }
  scenario "project-realization-api-capability" {
    capabilityId "deliver-realization-api";
    label "Project one planned capability into an owned disposable root";
    nodeIds ["s3-input", "s3-event", "s3-outcome"];
    sourceRefs ["src-00026", "src-00027"];
  }
  scenario "observe-realization-api-projection" {
    capabilityId "deliver-realization-api";
    label "Read process-local projection status and receipt";
    nodeIds ["s4-input", "s4-event", "s4-outcome"];
    sourceRefs ["src-00028", "src-00029"];
  }
  scenario "dispose-realization-api-roots" {
    capabilityId "deliver-realization-api";
    label "Remove only realization roots owned by this API";
    nodeIds ["s5-input", "s5-event", "s5-outcome"];
    sourceRefs ["src-00030", "src-00031"];
  }
  input "s0-input" {
    label "realization api delivery request";
    detail "the sidefx-realization-api authority at version 0.1.0 with host 127.0.0.1, its admitted port, and exactly six declared operations";
    capabilityId "deliver-realization-api";
    scenarioId "deliver-realization-api";
    basis "DECLARED";
    sourceRefs ["src-00020", "src-00021"];
    layer "mechanic";
    productContract "realization-api-delivery-request.v1";
  }
  event "s0-event" {
    label "realization api delivery requested";
    detail "HTTP delivery is requested";
    capabilityId "deliver-realization-api";
    scenarioId "deliver-realization-api";
    basis "DECLARED";
    sourceRefs ["src-00020", "src-00021"];
    layer "mechanic";
  }
  outcome "s0-outcome" {
    label "realization api delivery result";
    detail "one loopback server starts, only authority-declared method and path pairs are routed, JSON request bodies are bounded, and JSON responses use exact status an…";
    capabilityId "deliver-realization-api";
    scenarioId "deliver-realization-api";
    basis "DECLARED";
    sourceRefs ["src-00020", "src-00021"];
    layer "mechanic";
    productContract "realization-api-delivery-result.v1";
  }
  input "s1-input" {
    label "realization api delivery request";
    detail "an optional case-insensitive query or an exact capability identity";
    capabilityId "deliver-realization-api";
    scenarioId "discover-realization-api-capabilities";
    basis "DECLARED";
    sourceRefs ["src-00022", "src-00023"];
    layer "mechanic";
    productContract "realization-api-delivery-request.v1";
  }
  event "s1-event" {
    label "realization api capability discovery requested";
    detail "GET /capabilities or GET /capabilities/:capabilityId is requested";
    capabilityId "deliver-realization-api";
    scenarioId "discover-realization-api-capabilities";
    basis "DECLARED";
    sourceRefs ["src-00022", "src-00023"];
    layer "mechanic";
  }
  outcome "s1-outcome" {
    label "realization api delivery result";
    detail "the request delegates to the bound capsule discovery operation and returns stable content-addressed capsule metadata or the exact not-found representation";
    capabilityId "deliver-realization-api";
    scenarioId "discover-realization-api-capabilities";
    basis "DECLARED";
    sourceRefs ["src-00022", "src-00023"];
    layer "mechanic";
    productContract "realization-api-delivery-result.v1";
  }
  input "s2-input" {
    label "realization api delivery request";
    detail "a capability identity and a target operating system from windows, macos, or linux with architecture x64 or arm64";
    capabilityId "deliver-realization-api";
    scenarioId "plan-realization-api-target";
    basis "DECLARED";
    sourceRefs ["src-00024", "src-00025"];
    layer "mechanic";
    productContract "realization-api-delivery-request.v1";
  }
  event "s2-event" {
    label "realization api plan requested";
    detail "POST /realization-plans is requested";
    capabilityId "deliver-realization-api";
    scenarioId "plan-realization-api-target";
    basis "DECLARED";
    sourceRefs ["src-00024", "src-00025"];
    layer "mechanic";
  }
  outcome "s2-outcome" {
    label "realization api delivery result";
    detail "the verified capsule, dependencies, host profile, required providers, projection eligibility, requested experience, activation, and collapsed durable layout …";
    capabilityId "deliver-realization-api";
    scenarioId "plan-realization-api-target";
    basis "DECLARED";
    sourceRefs ["src-00024", "src-00025"];
    layer "mechanic";
    productContract "realization-api-delivery-result.v1";
  }
  input "s3-input" {
    label "realization api delivery request";
    detail "a plannable realization plan bound to the local host target";
    capabilityId "deliver-realization-api";
    scenarioId "project-realization-api-capability";
    basis "DECLARED";
    sourceRefs ["src-00026", "src-00027"];
    layer "mechanic";
    productContract "realization-api-delivery-request.v1";
  }
  event "s3-event" {
    label "realization api projection requested";
    detail "POST /projections is requested";
    capabilityId "deliver-realization-api";
    scenarioId "project-realization-api-capability";
    basis "DECLARED";
    sourceRefs ["src-00026", "src-00027"];
    layer "mechanic";
  }
  outcome "s3-outcome" {
    label "realization api delivery result";
    detail "an ownership-marked realization root is created beside the repository, the estate is expanded and projected there, selected direct execution is proven, and a…";
    capabilityId "deliver-realization-api";
    scenarioId "project-realization-api-capability";
    basis "DECLARED";
    sourceRefs ["src-00026", "src-00027"];
    layer "mechanic";
    productContract "realization-api-delivery-result.v1";
  }
  input "s4-input" {
    label "realization api delivery request";
    detail "one projection identity known to the running delivery instance";
    capabilityId "deliver-realization-api";
    scenarioId "observe-realization-api-projection";
    basis "DECLARED";
    sourceRefs ["src-00028", "src-00029"];
    layer "mechanic";
    productContract "realization-api-delivery-request.v1";
  }
  event "s4-event" {
    label "realization api projection observation requested";
    detail "GET /projections/:projectionId or GET /projections/:projectionId/receipt is requested";
    capabilityId "deliver-realization-api";
    scenarioId "observe-realization-api-projection";
    basis "DECLARED";
    sourceRefs ["src-00028", "src-00029"];
    layer "mechanic";
  }
  outcome "s4-outcome" {
    label "realization api delivery result";
    detail "PROJECTING, COMPLETE, or FAILED status is returned and a receipt is returned only after completion, while unknown identities and unavailable receipts use the…";
    capabilityId "deliver-realization-api";
    scenarioId "observe-realization-api-projection";
    basis "DECLARED";
    sourceRefs ["src-00028", "src-00029"];
    layer "mechanic";
    productContract "realization-api-delivery-result.v1";
  }
  input "s5-input" {
    label "realization api delivery request";
    detail "process-local realization roots and sibling directories that may not belong to this server";
    capabilityId "deliver-realization-api";
    scenarioId "dispose-realization-api-roots";
    basis "DECLARED";
    sourceRefs ["src-00030", "src-00031"];
    layer "mechanic";
    productContract "realization-api-delivery-request.v1";
  }
  event "s5-event" {
    label "realization api disposal requested";
    detail "startup sweeping or graceful shutdown occurs";
    capabilityId "deliver-realization-api";
    scenarioId "dispose-realization-api-roots";
    basis "DECLARED";
    sourceRefs ["src-00030", "src-00031"];
    layer "mechanic";
  }
  outcome "s5-outcome" {
    label "realization api delivery result";
    detail "only directories beside the repository whose names and exact ownership markers prove API ownership are removed and every unowned path remains untouched";
    capabilityId "deliver-realization-api";
    scenarioId "dispose-realization-api-roots";
    basis "DECLARED";
    sourceRefs ["src-00030", "src-00031"];
    layer "mechanic";
    productContract "realization-api-delivery-result.v1";
