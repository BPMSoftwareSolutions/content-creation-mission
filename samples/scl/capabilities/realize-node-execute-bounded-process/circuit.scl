scl "0.1";
circuit "realize-node-execute-bounded-process" {
  title "Realize the admitted bounded-process mechanic on Node";
  promise "{\"experienceId\": \"bounded-node-process-testimony.v1\", \"actor\": \"projected capability\", \"promise\": \"one admitted request performs at most one shell-free process effect and returns exactly one bounded terminal testimony\", \"observableConditions\": [{\"conditionId\": \"unadmitted-request-performs-no-effect\"}, {\"conditionId\": \"shell-is-never-invoked\"}, {\"conditionId\": \"provider-return-is-bounded\"}, {\"conditionId\": \"every-process-outcome-is-terminal\"}, {\"conditionId\": \"process-success-is-not-capability-acceptance\"}, {\"conditionId\": \"output-memory-is-bounded\"}]}";
