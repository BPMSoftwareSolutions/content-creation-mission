circuit "evaluate-sidefx-proof-binding" {
  title "Evaluate SideFX proof binding";
  promise "{\"experienceType\": \"promised-experience.v1\", \"experienceId\": \"sidefx-proof-binding-evaluation-is-observable\", \"actor\": \"SideFX semantic authority maintainer\", \"promise\": \"Every evaluated proof binding and obligation produces a profile-governed disposition with explicit lineage findings and no conformance receipt or admission claim.\", \"observableConditions\": [{\"conditionId\": \"obligation-disposition-is-visible\", \"statement\": \"the profile-governed obligation disposition is observable\"}, {\"conditionId\": \"lineage-findings-are-retained\", \"statement\": \"the exact lineage findings remain observable in the evaluation record\"}, {\"conditionId\": \"single-disposition-per-obligation\", \"statement\": \"exactly one honest disposition is produced per evaluated obligation\"}]}";
