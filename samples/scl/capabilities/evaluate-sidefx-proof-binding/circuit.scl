  capability "evaluate-sidefx-proof-binding" {
    label "Evaluate SideFX proof binding";
    domain "Frozen source corpus";
    scenarioIds ["evaluate-sidefx-proof-binding", "accept-explicit-or-deterministic-current-binding", "report-missing-evidence-not-observable", "report-current-failure-not-satisfied", "report-admitted-exclusion-not-applicable", "reject-prohibited-binding-basis", "reject-stale-or-mixed-proof-lineage", "reproduce-proof-binding-evaluation-deterministically"];
    coverage "8 declared scenarios; native detail remains separately inspectable";
    sourceRefs ["src-00000"];
  }
  scenario "evaluate-sidefx-proof-binding" {
    capabilityId "evaluate-sidefx-proof-binding";
    label "Evaluate one proof obligation under the frozen binding profile";
    nodeIds ["s0-input", "s0-event", "s0-outcome"];
    sourceRefs ["src-00020", "src-00021"];
  }
  scenario "accept-explicit-or-deterministic-current-binding" {
    capabilityId "evaluate-sidefx-proof-binding";
    label "Accept an explicit or deterministic binding with current passing evidence";
    nodeIds ["s1-input", "s1-event", "s1-outcome"];
    sourceRefs ["src-00022", "src-00023"];
  }
  scenario "report-missing-evidence-not-observable" {
    capabilityId "evaluate-sidefx-proof-binding";
    label "Report missing required evidence as not observable";
    nodeIds ["s2-input", "s2-event", "s2-outcome"];
    sourceRefs ["src-00024", "src-00025"];
  }
  scenario "report-current-failure-not-satisfied" {
    capabilityId "evaluate-sidefx-proof-binding";
    label "Report current admitted failing evidence as not satisfied";
    nodeIds ["s3-input", "s3-event", "s3-outcome"];
    sourceRefs ["src-00026", "src-00027"];
  }
  scenario "report-admitted-exclusion-not-applicable" {
    capabilityId "evaluate-sidefx-proof-binding";
    label "Report an admitted authority exclusion as not applicable";
    nodeIds ["s4-input", "s4-event", "s4-outcome"];
    sourceRefs ["src-00028", "src-00029"];
  }
  scenario "reject-prohibited-binding-basis" {
    capabilityId "evaluate-sidefx-proof-binding";
    label "Reject proximity prose similarity and model testimony as proof basis";
    nodeIds ["s5-input", "s5-event", "s5-outcome"];
    sourceRefs ["src-00030", "src-00031"];
  }
  scenario "reject-stale-or-mixed-proof-lineage" {
    capabilityId "evaluate-sidefx-proof-binding";
    label "Reject stale or mixed snapshot lineage before evaluating proof";
    nodeIds ["s6-input", "s6-event", "s6-outcome"];
    sourceRefs ["src-00032", "src-00033"];
  }
  scenario "reproduce-proof-binding-evaluation-deterministically" {
    capabilityId "evaluate-sidefx-proof-binding";
    label "Reproduce a proof-binding evaluation from pinned ordered inputs";
    nodeIds ["s7-input", "s7-event", "s7-outcome"];
    sourceRefs ["src-00034", "src-00035"];
  }
  input "s0-input" {
    label "sidefx proof binding evaluation request";
    detail "one pinned snapshot, the frozen SideFX proof-binding profile, and one declared proof obligation";
    capabilityId "evaluate-sidefx-proof-binding";
    scenarioId "evaluate-sidefx-proof-binding";
    basis "DECLARED";
    sourceRefs ["src-00020", "src-00021"];
    layer "mechanic";
    productContract "sidefx-proof-binding-evaluation-input.v1";
  }
  event "s0-event" {
    label "sidefx proof binding evaluation requested";
    detail "explicit bindings, deterministic rules, applicability, and evidence lineage are evaluated in profile order";
    capabilityId "evaluate-sidefx-proof-binding";
    scenarioId "evaluate-sidefx-proof-binding";
    basis "DECLARED";
    sourceRefs ["src-00020", "src-00021"];
    layer "mechanic";
  }
  outcome "s0-outcome" {
    label "sidefx proof binding evaluation record";
    detail "exactly one honest obligation disposition and its lineage findings are retained without turning the operational record into a conformance receipt or admissio…";
    capabilityId "evaluate-sidefx-proof-binding";
    scenarioId "evaluate-sidefx-proof-binding";
    basis "DECLARED";
    sourceRefs ["src-00020", "src-00021"];
    layer "mechanic";
    productContract "sidefx-proof-binding-evaluation-record.v1";
  }
  input "s1-input" {
    label "current proof binding evaluation";
    detail "explicit fixture authority or a canonical-ID deterministic rule and current admitted passing evidence";
    capabilityId "evaluate-sidefx-proof-binding";
    scenarioId "accept-explicit-or-deterministic-current-binding";
    basis "DECLARED";
    sourceRefs ["src-00022", "src-00023"];
    layer "mechanic";
    productContract "sidefx-proof-binding-evaluation-record.v1";
  }
  event "s1-event" {
    label "current proof binding evaluation requested";
    detail "the declared binding path is evaluated";
    capabilityId "evaluate-sidefx-proof-binding";
    scenarioId "accept-explicit-or-deterministic-current-binding";
    basis "DECLARED";
    sourceRefs ["src-00022", "src-00023"];
    layer "mechanic";
  }
  outcome "s1-outcome" {
    label "current proof binding evaluation record";
    detail "the binding is retained as BOUND and the obligation is SATISFIED without treating the result as capability admission or conformance";
    capabilityId "evaluate-sidefx-proof-binding";
    scenarioId "accept-explicit-or-deterministic-current-binding";
    basis "DECLARED";
    sourceRefs ["src-00022", "src-00023"];
    layer "mechanic";
    productContract "sidefx-proof-binding-evaluation-record.v1";
  }
  input "s2-input" {
    label "missing proof evidence evaluation";
    detail "a required proof obligation whose subject binding or evidence is absent";
    capabilityId "evaluate-sidefx-proof-binding";
    scenarioId "report-missing-evidence-not-observable";
    basis "DECLARED";
    sourceRefs ["src-00024", "src-00025"];
    layer "mechanic";
    productContract "sidefx-proof-binding-evaluation-record.v1";
  }
  event "s2-event" {
    label "missing proof evidence evaluation requested";
    detail "the obligation is evaluated";
    capabilityId "evaluate-sidefx-proof-binding";
    scenarioId "report-missing-evidence-not-observable";
    basis "DECLARED";
    sourceRefs ["src-00024", "src-00025"];
    layer "mechanic";
  }
  outcome "s2-outcome" {
    label "missing proof evidence evaluation record";
    detail "the obligation is NOT_OBSERVABLE and no failure is inferred from absence alone";
    capabilityId "evaluate-sidefx-proof-binding";
    scenarioId "report-missing-evidence-not-observable";
    basis "DECLARED";
    sourceRefs ["src-00024", "src-00025"];
    layer "mechanic";
    productContract "sidefx-proof-binding-evaluation-record.v1";
  }
  input "s3-input" {
    label "current failing proof evidence evaluation";
    detail "a required proof obligation with current admitted evidence that explicitly fails it";
    capabilityId "evaluate-sidefx-proof-binding";
