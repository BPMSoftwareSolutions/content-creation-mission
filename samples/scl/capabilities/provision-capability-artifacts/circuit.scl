  capability "provision-capability-artifacts" {
    label "Decide which observed artifacts enter the content-addressed capability estate";
    domain "Frozen source corpus";
    scenarioIds ["provision-capability-artifacts", "admit-provisioning-batch-request", "screen-observed-artifacts-against-policy", "classify-artifact-by-declared-extension", "resolve-artifact-provisioning-disposition", "bind-provisioning-manifest-entries", "close-provisioning-coverage"];
    coverage "7 declared scenarios; native detail remains separately inspectable";
    sourceRefs ["src-00000"];
  }
  scenario "provision-capability-artifacts" {
    capabilityId "provision-capability-artifacts";
    label "Return one exact provisioning decision for one presented batch";
    nodeIds ["s0-input", "s0-event", "s0-outcome"];
    sourceRefs ["src-00024", "src-00025"];
  }
  scenario "admit-provisioning-batch-request" {
    capabilityId "provision-capability-artifacts";
    label "Admit the batch request before observing anything about its artifacts";
    nodeIds ["s1-input", "s1-event", "s1-outcome"];
    sourceRefs ["src-00026", "src-00027"];
  }
  scenario "screen-observed-artifacts-against-policy" {
    capabilityId "provision-capability-artifacts";
    label "Reject any artifact whose supplied screen carries a finding";
    nodeIds ["s2-input", "s2-event", "s2-outcome"];
    sourceRefs ["src-00028", "src-00029"];
  }
  scenario "classify-artifact-by-declared-extension" {
    capabilityId "provision-capability-artifacts";
    label "Classify each artifact from the declared catalog rather than inferring it";
    nodeIds ["s3-input", "s3-event", "s3-outcome"];
    sourceRefs ["src-00030", "src-00031"];
  }
  scenario "resolve-artifact-provisioning-disposition" {
    capabilityId "provision-capability-artifacts";
    label "Resolve what provisioning disposition each artifact earns";
    nodeIds ["s4-input", "s4-event", "s4-outcome"];
    sourceRefs ["src-00032", "src-00033"];
  }
  scenario "bind-provisioning-manifest-entries" {
    capabilityId "provision-capability-artifacts";
    label "Bind one content-addressed entry for every provisioned artifact";
    nodeIds ["s5-input", "s5-event", "s5-outcome"];
    sourceRefs ["src-00034", "src-00035"];
  }
  scenario "close-provisioning-coverage" {
    capabilityId "provision-capability-artifacts";
    label "Prove every selected artifact was accounted for";
    nodeIds ["s6-input", "s6-event", "s6-outcome"];
    sourceRefs ["src-00036", "src-00037"];
  }
  input "s0-input" {
    label "provisioning request";
    detail "one admitted batch request and the observed artifacts it selected";
    capabilityId "provision-capability-artifacts";
    scenarioId "provision-capability-artifacts";
    basis "DECLARED";
    sourceRefs ["src-00024", "src-00025"];
    layer "mechanic";
    productContract "capability-provisioning-request.v1";
  }
  event "s0-event" {
    label "provision capability artifacts";
    detail "the batch is provisioned";
    capabilityId "provision-capability-artifacts";
    scenarioId "provision-capability-artifacts";
    basis "DECLARED";
    sourceRefs ["src-00024", "src-00025"];
    layer "mechanic";
  }
  outcome "s0-outcome" {
    label "provisioning decision";
    detail "one decision binds every provisioned entry, every rejection, and the exact coverage of the selection PROVISIONED is returned only when every observed artifac…";
    capabilityId "provision-capability-artifacts";
    scenarioId "provision-capability-artifacts";
    basis "DECLARED";
    sourceRefs ["src-00024", "src-00025"];
    layer "mechanic";
    productContract "capability-provisioning-decision.v1";
  }
  input "s1-input" {
    label "provisioning inputs";
    detail "one batch request declaring its zone, its source node and its selections";
    capabilityId "provision-capability-artifacts";
    scenarioId "admit-provisioning-batch-request";
    basis "DECLARED";
    sourceRefs ["src-00026", "src-00027"];
    layer "mechanic";
    productContract "provisioning-carrier.v1";
  }
  event "s1-event" {
    label "admit provisioning batch request";
    detail "the request is admitted";
    capabilityId "provision-capability-artifacts";
    scenarioId "admit-provisioning-batch-request";
    basis "DECLARED";
    sourceRefs ["src-00026", "src-00027"];
    layer "mechanic";
  }
  outcome "s1-outcome" {
    label "admitted request";
    detail "the batch identity, zone and selection set are bound exactly as declared a batch declaring no selection returns PROVISIONING_SELECTION_UNDECLARED a batch pre…";
    capabilityId "provision-capability-artifacts";
