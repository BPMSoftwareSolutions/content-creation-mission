scl "0.1";
circuit "obtain-governed-speech-media" {
  title "Obtain governed speech media from the bound narration provider";
  promise "{\"experienceId\": \"obtain-governed-speech-media.v1\", \"actor\": \"narration-provider-consumer\", \"promise\": \"one authorized narration generation request produces exactly one attributable speech media testimony, or exact held evidence naming the boundary that stopped it; no admission, no fidelity claim, and no artifact existence is ever established here\", \"observableConditions\": [{\"conditionId\": \"wire-request-projection-is-provider-neutral\"}, {\"conditionId\": \"exchange-observation-retains-provider-testimony\"}, {\"conditionId\": \"media-disposition-resolves-decodable-modality\"}, {\"conditionId\": \"media-bytes-and-digest-attributable\"}]}";
