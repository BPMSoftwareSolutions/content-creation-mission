  capability "observe-capability-change" {
    label "Observe one governed capability change";
    domain "Frozen source corpus";
    scenarioIds ["observe-capability-change", "resolve-capability-change-state", "resolve-capability-change-next-action", "represent-capability-change-evidence", "hold-unobservable-capability-change"];
    coverage "5 declared scenarios; native detail remains separately inspectable";
    sourceRefs ["src-00000"];
  }
  scenario "observe-capability-change" {
    capabilityId "observe-capability-change";
    label "Observe the authoritative status of one change";
    nodeIds ["s0-input", "s0-event", "s0-outcome"];
    sourceRefs ["src-00024", "src-00025"];
  }
  scenario "resolve-capability-change-state" {
    capabilityId "observe-capability-change";
    label "Resolve state only from authoritative receipts";
    nodeIds ["s1-input", "s1-event", "s1-outcome"];
    sourceRefs ["src-00026", "src-00027"];
  }
  scenario "resolve-capability-change-next-action" {
    capabilityId "observe-capability-change";
    label "Resolve the next legitimate action from state and findings";
    nodeIds ["s2-input", "s2-event", "s2-outcome"];
    sourceRefs ["src-00028", "src-00029"];
  }
  scenario "represent-capability-change-evidence" {
    capabilityId "observe-capability-change";
    label "Represent parallel authoring and proof evidence without conflating them";
    nodeIds ["s3-input", "s3-event", "s3-outcome"];
    sourceRefs ["src-00030", "src-00031"];
  }
  scenario "hold-unobservable-capability-change" {
    capabilityId "observe-capability-change";
    label "Report missing or divergent change evidence exactly";
    nodeIds ["s4-input", "s4-event", "s4-outcome"];
    sourceRefs ["src-00032", "src-00033"];
  }
  input "s0-input" {
    label "capability change status request";
    detail "one change identity or one current governed change context";
    capabilityId "observe-capability-change";
    scenarioId "observe-capability-change";
    basis "DECLARED";
    sourceRefs ["src-00024", "src-00025"];
    layer "mechanic";
    productContract "capability-change-status-request.v1";
  }
  event "s0-event" {
    label "capability change status requested";
    detail "capability change status is requested";
    capabilityId "observe-capability-change";
    scenarioId "observe-capability-change";
    basis "DECLARED";
    sourceRefs ["src-00024", "src-00025"];
    layer "mechanic";
  }
  outcome "s0-outcome" {
    label "capability change status";
    detail "one read-only status reports identity, reason, root capability, baseline, mutation set, impact proof set, state, stage, evidence, findings, admitted-authorit…";
    capabilityId "observe-capability-change";
    scenarioId "observe-capability-change";
    basis "DECLARED";
    sourceRefs ["src-00024", "src-00025"];
    layer "mechanic";
    productContract "capability-change-status.v1";
  }
  input "s1-input" {
    label "capability change status request";
    detail "one change set and any opening, sealing, publication, rejection, or recovery receipts bound to it";
    capabilityId "observe-capability-change";
    scenarioId "resolve-capability-change-state";
    basis "DECLARED";
    sourceRefs ["src-00026", "src-00027"];
    layer "mechanic";
    productContract "capability-change-status-request.v1";
  }
  event "s1-event" {
    label "capability change state resolution requested";
    detail "the current state is resolved";
    capabilityId "observe-capability-change";
    scenarioId "resolve-capability-change-state";
    basis "DECLARED";
    sourceRefs ["src-00026", "src-00027"];
    layer "mechanic";
  }
  outcome "s1-outcome" {
    label "capability change state";
    detail "exactly one OPEN, SEALED, PUBLISHED, or REJECTED state and its current stage are derived from closed receipt lineage without testimony declaring its own success";
    capabilityId "observe-capability-change";
    scenarioId "resolve-capability-change-state";
    basis "DECLARED";
    sourceRefs ["src-00026", "src-00027"];
    layer "mechanic";
    productContract "capability-change-state.v1";
  }
  input "s2-input" {
    label "capability change state";
    detail "one authoritative change state, its mutation boundary, current findings, and admitted lifecycle policy";
    capabilityId "observe-capability-change";
    scenarioId "resolve-capability-change-next-action";
    basis "DECLARED";
    sourceRefs ["src-00028", "src-00029"];
    layer "mechanic";
    productContract "capability-change-state.v1";
  }
  event "s2-event" {
    label "capability change next action resolution requested";
    detail "the next legitimate action is resolved";
    capabilityId "observe-capability-change";
    scenarioId "resolve-capability-change-next-action";
    basis "DECLARED";
    sourceRefs ["src-00028", "src-00029"];
    layer "mechanic";
  }
  outcome "s2-outcome" {
    label "capability change next action";
    detail "the result names only an action authorized in the current state or reports that no action is authorized without widening scope or mutation permission";
    capabilityId "observe-capability-change";
    scenarioId "resolve-capability-change-next-action";
    basis "DECLARED";
    sourceRefs ["src-00028", "src-00029"];
    layer "mechanic";
    productContract "capability-change-next-action.v1";
  }
  input "s3-input" {
    label "capability change state";
    detail "retained authoring testimony, semantic and blueprint deltas, conformance, fixtures, impact proofs, Cross-Apply, capsule proof, and publication receipts";
    capabilityId "observe-capability-change";
    scenarioId "represent-capability-change-evidence";
    basis "DECLARED";
    sourceRefs ["src-00030", "src-00031"];
    layer "mechanic";
    productContract "capability-change-state.v1";
  }
  event "s3-event" {
    label "capability change evidence representation requested";
    detail "change evidence is represented";
    capabilityId "observe-capability-change";
    scenarioId "represent-capability-change-evidence";
    basis "DECLARED";
    sourceRefs ["src-00030", "src-00031"];
    layer "mechanic";
  }
  outcome "s3-outcome" {
    label "capability change evidence view";
    detail "each evidence stream retains its authority, disposition, digest, and relationship to the current state without activity testimony becoming admission evidence";
    capabilityId "observe-capability-change";
    scenarioId "represent-capability-change-evidence";
    basis "DECLARED";
    sourceRefs ["src-00030", "src-00031"];
    layer "mechanic";
    productContract "capability-change-evidence-view.v1";
  }
  input "s4-input" {
    label "capability change observation findings";
    detail "an unknown change identity, missing authoritative state, divergent receipt lineage, or inaccessible evidence";
    capabilityId "observe-capability-change";
    scenarioId "hold-unobservable-capability-change";
    basis "DECLARED";
    sourceRefs ["src-00032", "src-00033"];
    layer "mechanic";
    productContract "capability-change-observation-findings.v1";
  }
  event "s4-event" {
    label "capability change observation disposition requested";
    detail "the observation disposition is resolved";
    capabilityId "observe-capability-change";
    scenarioId "hold-unobservable-capability-change";
    basis "DECLARED";
    sourceRefs ["src-00032", "src-00033"];
    layer "mechanic";
  }
  outcome "s4-outcome" {
    label "held capability change observation";
    detail "STATUS_HELD returns exact findings without mutating the change, selecting a replacement state, or hiding the last verified admitted-authority relationship";
    capabilityId "observe-capability-change";
    scenarioId "hold-unobservable-capability-change";
    basis "DECLARED";
    sourceRefs ["src-00032", "src-00033"];
    layer "mechanic";
