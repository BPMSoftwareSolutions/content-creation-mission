  capability "evaluate-semantic-carrier-compilation-evidence" {
    label "Adjudicate independently manufactured semantic carrier compilation evidence";
    domain "Frozen source corpus";
    scenarioIds ["evaluate-semantic-carrier-compilation", "return-evaluation-held", "return-review-ready-evaluation", "return-evaluator-replacement-for-independent-adjudication"];
    coverage "4 declared scenarios; native detail remains separately inspectable";
    sourceRefs ["src-00000"];
  }
  scenario "evaluate-semantic-carrier-compilation" {
    capabilityId "evaluate-semantic-carrier-compilation-evidence";
    label "Evaluate semantic carrier compilation";
    nodeIds ["s0-input", "s0-event", "s0-outcome"];
    sourceRefs ["src-00031", "src-00032"];
  }
  scenario "return-evaluation-held" {
    capabilityId "evaluate-semantic-carrier-compilation-evidence";
    label "Return evaluation held";
    nodeIds ["s1-input", "s1-event", "s1-outcome"];
    sourceRefs ["src-00033", "src-00034"];
  }
  scenario "return-review-ready-evaluation" {
    capabilityId "evaluate-semantic-carrier-compilation-evidence";
    label "Return review-ready evaluation";
    nodeIds ["s2-input", "s2-event", "s2-outcome"];
    sourceRefs ["src-00035", "src-00036"];
  }
  scenario "return-evaluator-replacement-for-independent-adjudication" {
    capabilityId "evaluate-semantic-carrier-compilation-evidence";
    label "Return evaluator replacement for independent adjudication";
    nodeIds ["s3-input", "s3-event", "s3-outcome"];
    sourceRefs ["src-00037", "src-00038"];
  }
  input "s0-input" {
    label "semantic carrier compilation evaluation request";
    detail "one graph-bound validator and extraction lineage plus a complete independently manufactured proof set";
    capabilityId "evaluate-semantic-carrier-compilation-evidence";
    scenarioId "evaluate-semantic-carrier-compilation";
    basis "DECLARED";
    sourceRefs ["src-00031", "src-00032"];
    layer "mechanic";
    productContract "semantic-carrier-compilation-evaluation-request.v1";
  }
  event "s0-event" {
    label "adjudicate semantic carrier compilation evidence";
    detail "the supplied evidence is adjudicated without evaluator evidence manufacture";
    capabilityId "evaluate-semantic-carrier-compilation-evidence";
    scenarioId "evaluate-semantic-carrier-compilation";
    basis "DECLARED";
    sourceRefs ["src-00031", "src-00032"];
    layer "mechanic";
  }
  outcome "s0-outcome" {
    label "semantic carrier compilation evaluation classified";
    detail "evaluation is classified for ordinary review, hold, or evaluator-replacement independent adjudication";
    capabilityId "evaluate-semantic-carrier-compilation-evidence";
    scenarioId "evaluate-semantic-carrier-compilation";
    basis "DECLARED";
    sourceRefs ["src-00031", "src-00032"];
    layer "mechanic";
    productContract "semantic-carrier-compilation-evaluation-stage.v1";
  }
  input "s1-input" {
    label "held evaluation stage";
    detail "ordered attributable evidence, lineage, blackout, or independence findings";
    capabilityId "evaluate-semantic-carrier-compilation-evidence";
    scenarioId "return-evaluation-held";
    basis "DECLARED";
    sourceRefs ["src-00033", "src-00034"];
    layer "mechanic";
    productContract "semantic-carrier-compilation-evaluation-stage.v1";
  }
  event "s1-event" {
    label "return evaluation held";
    detail "the evaluation-held receipt is returned";
    capabilityId "evaluate-semantic-carrier-compilation-evidence";
    scenarioId "return-evaluation-held";
    basis "DECLARED";
    sourceRefs ["src-00033", "src-00034"];
    layer "mechanic";
  }
  outcome "s1-outcome" {
    label "semantic carrier compilation evaluation held";
    detail "EVALUATION_HELD is returned with ordered attributable findings";
    capabilityId "evaluate-semantic-carrier-compilation-evidence";
    scenarioId "return-evaluation-held";
    basis "DECLARED";
    sourceRefs ["src-00033", "src-00034"];
    layer "mechanic";
    productContract "semantic-carrier-compilation-evaluation-result.v1";
  }
  input "s2-input" {
    label "review ready evaluation stage";
    detail "complete passing independent evidence for a non-evaluator-replacement subject";
    capabilityId "evaluate-semantic-carrier-compilation-evidence";
    scenarioId "return-review-ready-evaluation";
    basis "DECLARED";
    sourceRefs ["src-00035", "src-00036"];
    layer "mechanic";
    productContract "semantic-carrier-compilation-evaluation-stage.v1";
  }
  event "s2-event" {
    label "return review ready evaluation";
    detail "the ordinary-subject review-ready receipt is returned";
    capabilityId "evaluate-semantic-carrier-compilation-evidence";
    scenarioId "return-review-ready-evaluation";
    basis "DECLARED";
    sourceRefs ["src-00035", "src-00036"];
    layer "mechanic";
  }
  outcome "s2-outcome" {
    label "semantic carrier compilation review ready";
