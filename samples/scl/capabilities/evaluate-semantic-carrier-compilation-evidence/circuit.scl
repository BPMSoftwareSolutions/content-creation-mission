  title "Adjudicate independently manufactured semantic carrier compilation evidence";
  promise "{\"experienceType\": \"promised-experience.v1\", \"experienceId\": \"deterministic-semantic-carrier-evidence-adjudication.v1\", \"actor\": \"semantic-carrier compiler\", \"promise\": \"One extracted canonical graph and its independently manufactured proof set are adjudicated without evaluator evidence manufacture; ordinary subjects become review-ready or held, while evaluator replacement alone is diverted to independent adjudication.\", \"observableConditions\": [{\"conditionId\": \"complete-evidence-set-required\"}, {\"conditionId\": \"same-graph-lineage-required\"}, {\"conditionId\": \"evaluator-evidence-manufacture-prohibited\"}, {\"conditionId\": \"evaluator-replacement-only-independent-diversion\"}, {\"conditionId\": \"exact-terminal-disposition-returned\"}]}";
