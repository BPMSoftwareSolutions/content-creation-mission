  }
  meaning {
    nodeId "s2-outcome";
    altitude "scenario";
    experience "one media testimony retains provider identity, request and response hashes, attempt count, and timing alongside the returned audio payload; a response carrying no audio modality is held as absent modality; and an empty or undecodable payload is held as unusable rather than materialized as silence";
    variants ["NARRATION_MEDIA_RETURNED", "PROVIDER_MODALITY_ABSENT", "PROVIDER_PAYLOAD_UNUSABLE"];
    productIsExperience false;
  }
  meaning {
    nodeId "s3-input";
    altitude "scenario";
    variants [];
