  title "Open one governed capability change";
  promise "{\"experienceId\": \"open-capability-change.v1\", \"actor\": \"engineer or agent\", \"promise\": \"one exact admitted baseline, bounded mutation set, wider proof set, and isolated authoring boundary are bound without changing admitted authority\", \"observableConditions\": [{\"conditionId\": \"blueprint-route-closes-or-holds-exactly\"}, {\"conditionId\": \"change-kind-is-resolved-exactly\"}, {\"conditionId\": \"first-admission-opens-against-reviewed-feature-and-approved-blueprint\"}, {\"conditionId\": \"no-baseline-artefact-is-copied-or-fabricated-on-first-admission\"}]}";
