  capability "open-capability-change" {
    label "Open one governed capability change";
    domain "Frozen source corpus";
    scenarioIds ["open-capability-change", "resolve-capability-change-kind", "resolve-capability-change-baseline", "resolve-first-admission-authority", "resolve-capability-change-impact", "establish-capability-change-authoring-boundary", "hold-unopenable-capability-change"];
    coverage "7 declared scenarios; native detail remains separately inspectable";
    sourceRefs ["src-00000"];
  }
  scenario "open-capability-change" {
    capabilityId "open-capability-change";
    label "Open one governed change from admitted authority";
    nodeIds ["s0-input", "s0-event", "s0-outcome"];
    sourceRefs ["src-00030", "src-00031"];
  }
  scenario "resolve-capability-change-kind" {
    capabilityId "open-capability-change";
    label "Resolve which kind of change is being opened";
    nodeIds ["s1-input", "s1-event", "s1-outcome"];
    sourceRefs ["src-00032", "src-00033"];
  }
  scenario "resolve-capability-change-baseline" {
    capabilityId "open-capability-change";
    label "Resolve the exact admitted baseline of a revision";
    nodeIds ["s2-input", "s2-event", "s2-outcome"];
    sourceRefs ["src-00034", "src-00035"];
  }
  scenario "resolve-first-admission-authority" {
    capabilityId "open-capability-change";
    label "Resolve the reviewed authority a first admission opens against";
    nodeIds ["s3-input", "s3-event", "s3-outcome"];
    sourceRefs ["src-00036", "src-00037"];
  }
  scenario "resolve-capability-change-impact" {
    capabilityId "open-capability-change";
    label "Separate authorized mutation from required proof";
    nodeIds ["s4-input", "s4-event", "s4-outcome"];
    sourceRefs ["src-00038", "src-00039"];
  }
  scenario "establish-capability-change-authoring-boundary" {
    capabilityId "open-capability-change";
    label "Establish an isolated bounded authoring experience";
    nodeIds ["s5-input", "s5-event", "s5-outcome"];
    sourceRefs ["src-00040", "src-00041"];
  }
  scenario "hold-unopenable-capability-change" {
