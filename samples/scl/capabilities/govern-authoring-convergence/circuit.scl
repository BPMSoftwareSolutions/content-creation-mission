  capability "govern-authoring-convergence" {
    label "Govern one authoring convergence round deterministically";
    domain "Frozen source corpus";
    scenarioIds ["govern-authoring-convergence", "evaluate-expression-operator-conformance", "evaluate-scenario-edge-realization", "evaluate-port-binding-closure", "evaluate-execution-authority-closure", "evaluate-observed-sequence-closure", "evaluate-literal-discriminator-conformance", "bind-normalized-authoring-findings", "resolve-convergence-disposition"];
    coverage "9 declared scenarios; native detail remains separately inspectable";
    sourceRefs ["src-00000"];
  }
  scenario "govern-authoring-convergence" {
    capabilityId "govern-authoring-convergence";
    label "Govern one deterministic convergence round over a candidate";
    nodeIds ["s0-input", "s0-event", "s0-outcome"];
    sourceRefs ["src-00029", "src-00030"];
  }
  scenario "evaluate-expression-operator-conformance" {
    capabilityId "govern-authoring-convergence";
    label "Admit only declared operators carrying their declared operands";
    nodeIds ["s1-input", "s1-event", "s1-outcome"];
    sourceRefs ["src-00031", "src-00032"];
  }
  scenario "evaluate-scenario-edge-realization" {
    capabilityId "govern-authoring-convergence";
    label "Give one semantic edge exactly one realization";
    nodeIds ["s2-input", "s2-event", "s2-outcome"];
    sourceRefs ["src-00033", "src-00034"];
  }
  scenario "evaluate-port-binding-closure" {
    capabilityId "govern-authoring-convergence";
    label "Resolve every required port identity to exactly one declared binding";
    nodeIds ["s3-input", "s3-event", "s3-outcome"];
    sourceRefs ["src-00035", "src-00036"];
  }
  scenario "evaluate-execution-authority-closure" {
    capabilityId "govern-authoring-convergence";
    label "Resolve every declared scenario to exactly one execution authority";
    nodeIds ["s4-input", "s4-event", "s4-outcome"];
    sourceRefs ["src-00037", "src-00038"];
  }
  scenario "evaluate-observed-sequence-closure" {
    capabilityId "govern-authoring-convergence";
