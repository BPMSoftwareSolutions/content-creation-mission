  capability "interlock-agent-operation" {
    label "Govern one agent session through an admitted hook interlock";
    domain "Frozen source corpus";
    scenarioIds ["interlock-agent-operation", "admit-agent-interlock-request", "activate-agent-interlock", "certify-live-agent-interlock", "adjudicate-covered-agent-tool-call", "protect-agent-interlock-control-plane", "hold-untrusted-or-uncovered-agent-operation"];
    coverage "7 declared scenarios; native detail remains separately inspectable";
    sourceRefs ["src-00000"];
  }
  scenario "interlock-agent-operation" {
    capabilityId "interlock-agent-operation";
    label "Govern one requested agent operation without widening its authority";
    nodeIds ["s0-input", "s0-event", "s0-outcome"];
    sourceRefs ["src-00023", "src-00024"];
  }
  scenario "admit-agent-interlock-request" {
