  capability "observe-governed-http-exchange" {
    label "Observe governed HTTP exchanges";
    domain "Frozen source corpus";
    scenarioIds ["observe-governed-http-exchange", "observe-non-success-http-response", "reject-http-endpoint-outside-authority", "reject-invalid-http-credential-binding", "observe-governed-http-timeout", "cancel-governed-http-exchange", "observe-governed-http-transport-failure", "reject-oversized-http-response", "prove-http-secret-redaction", "prove-single-http-exchange-authority"];
    coverage "10 declared scenarios; native detail remains separately inspectable";
    sourceRefs ["src-00000"];
  }
  scenario "observe-governed-http-exchange" {
    capabilityId "observe-governed-http-exchange";
    label "Observe one successful authorized HTTP exchange";
    nodeIds ["s0-input", "s0-event", "s0-outcome"];
    sourceRefs ["src-00024", "src-00025"];
  }
  scenario "observe-non-success-http-response" {
    capabilityId "observe-governed-http-exchange";
    label "Retain a complete non-success HTTP response as testimony";
    nodeIds ["s1-input", "s1-event", "s1-outcome"];
    sourceRefs ["src-00026", "src-00027"];
  }
  scenario "reject-http-endpoint-outside-authority" {
    capabilityId "observe-governed-http-exchange";
    label "Reject a malformed forbidden or credential-bearing endpoint";
    nodeIds ["s2-input", "s2-event", "s2-outcome"];
    sourceRefs ["src-00028", "src-00029"];
  }
  scenario "reject-invalid-http-credential-binding" {
    capabilityId "observe-governed-http-exchange";
    label "Reject absent expired consumed or mismatched credential bindings";
    nodeIds ["s3-input", "s3-event", "s3-outcome"];
    sourceRefs ["src-00030", "src-00031"];
  }
  scenario "observe-governed-http-timeout" {
    capabilityId "observe-governed-http-exchange";
    label "Stop one exchange at the admitted timeout";
    nodeIds ["s4-input", "s4-event", "s4-outcome"];
    sourceRefs ["src-00032", "src-00033"];
  }
  scenario "cancel-governed-http-exchange" {
    capabilityId "observe-governed-http-exchange";
    label "Cancel before transmission or during one active exchange";
    nodeIds ["s5-input", "s5-event", "s5-outcome"];
    sourceRefs ["src-00034", "src-00035"];
  }
  scenario "observe-governed-http-transport-failure" {
    capabilityId "observe-governed-http-exchange";
    label "Retain DNS TLS socket and network failures as attributable testimony";
    nodeIds ["s6-input", "s6-event", "s6-outcome"];
    sourceRefs ["src-00036", "src-00037"];
  }
  scenario "reject-oversized-http-response" {
    capabilityId "observe-governed-http-exchange";
    label "Enforce the admitted response byte bound";
    nodeIds ["s7-input", "s7-event", "s7-outcome"];
    sourceRefs ["src-00038", "src-00039"];
  }
  scenario "prove-http-secret-redaction" {
    capabilityId "observe-governed-http-exchange";
    label "Exclude secret-bearing headers URLs and diagnostics from evidence";
    nodeIds ["s8-input", "s8-event", "s8-outcome"];
    sourceRefs ["src-00040", "src-00041"];
  }
  scenario "prove-single-http-exchange-authority" {
    capabilityId "observe-governed-http-exchange";
    label "Prove the transport performs no retry redirect escape or substitution";
    nodeIds ["s9-input", "s9-event", "s9-outcome"];
    sourceRefs ["src-00042", "src-00043"];
  }
  input "s0-input" {
