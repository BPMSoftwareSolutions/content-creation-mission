scl "0.1";
circuit "observe-governed-http-exchange" {
  title "Observe governed HTTP exchanges";
  promise "{\"experienceId\": \"observe-governed-http-exchange-experience.v1\", \"actor\": \"authorized-consumer\", \"promise\": \"exact status, policy-allowed headers, bounded response bytes, timing, hashes, and effect lineage are returned as untrusted testimony\", \"observableConditions\": [{\"conditionId\": \"governed-http-exchange-observed\"}]}";
  status "SOURCE_REVEAL";
  sourceGeneration "0b02db7ee691898d499cb9046737dce3f7c34aa8e1e3d6ca4908afeb823fb802";
