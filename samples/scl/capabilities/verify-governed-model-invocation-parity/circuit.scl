circuit "verify-governed-model-invocation-parity" {
  title "Verify governed model invocation parity";
  promise "{\"experienceType\": \"promised-experience.v1\", \"experienceId\": \"governed-model-invocation-parity-is-declared-and-compared\", \"actor\": \"capability steward\", \"promise\": \"Governed invocation terms are compared before any provider is invoked; a divergence is named exactly instead of being discovered at runtime.\", \"observableConditions\": [{\"conditionId\": \"invocations-observed\", \"statement\": \"every compared invocation and the shared invocation authority are observed before comparison\"}, {\"conditionId\": \"governed-terms-compared\", \"statement\": \"every term the shared authority fixes is compared across every admitted invocation\"}, {\"conditionId\": \"caller-terms-excluded\", \"statement\": \"terms the authority permits to vary by caller are excluded from comparison\"}, {\"conditionId\": \"divergences-named-exactly\", \"statement\": \"each diverging term is reported with the capabilities that disagree and the values they declared\"}]}";
