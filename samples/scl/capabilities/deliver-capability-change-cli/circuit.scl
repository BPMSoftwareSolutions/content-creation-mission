circuit "deliver-capability-change-cli" {
  title "Deliver capability change management through one command line";
  promise "{\"experienceId\": \"deliver-capability-change-cli.v1\", \"actor\": \"engineer or agent\", \"promise\": \"Engineers and agents use one stable `sidefx change` command surface while open, seal, publish, and observe capabilities retain all lifecycle meaning. Command-line delivery owns only argument and standard-stream carriers, canonical operation request construction, capability invocation, result rendering, and exact usage failures.\", \"observableConditions\": [{\"conditionId\": \"delivery-and-lifecycle-dispositions-remain-distinct\"}]}";
  status "SOURCE_REVEAL";
  sourceGeneration "0b02db7ee691898d499cb9046737dce3f7c34aa8e1e3d6ca4908afeb823fb802";
