  capability "resolve-estate-dependency-closure" {
    label "Resolve whether every admitted capability in the estate can still be executed";
    domain "Frozen source corpus";
    scenarioIds ["resolve-estate-dependency-closure", "resolve-declared-dependencies", "recompute-binding-digests", "detect-stale-pins", "close-execution-resolvability"];
    coverage "5 declared scenarios; native detail remains separately inspectable";
