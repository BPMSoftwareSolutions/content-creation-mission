  }
  scenario "resolve-estate-dependency-closure" {
    capabilityId "resolve-estate-dependency-closure";
    label "Return the exact executability disposition of one presented estate";
    nodeIds ["s0-input", "s0-event", "s0-outcome"];
    sourceRefs ["src-00018", "src-00019"];
  }
  scenario "resolve-declared-dependencies" {
