  capability "verify-model-connection-conformance" {
    label "Verify model connection conformance";
    domain "Frozen source corpus";
    scenarioIds ["verify-model-connection-conformance", "reject-incomplete-model-provider-conformance-coverage", "detect-model-protocol-request-projection-divergence", "detect-model-provider-testimony-normalization-divergence", "detect-model-attempt-and-receipt-divergence", "detect-model-connection-secret-leakage", "detect-model-connection-host-divergence", "reject-unclosed-model-connection-runtime", "reject-nondeterministic-or-live-conformance-fixture"];
    coverage "9 declared scenarios; native detail remains separately inspectable";
    sourceRefs ["src-00000"];
  }
  scenario "verify-model-connection-conformance" {
    capabilityId "verify-model-connection-conformance";
    label "Prove all declared adapters and hosts against every fixture partition";
    nodeIds ["s0-input", "s0-event", "s0-outcome"];
    sourceRefs ["src-00029", "src-00030"];
  }
  scenario "reject-incomplete-model-provider-conformance-coverage" {
    capabilityId "verify-model-connection-conformance";
    label "Fail when a declared provider adapter mode or host lacks fixtures";
    nodeIds ["s1-input", "s1-event", "s1-outcome"];
    sourceRefs ["src-00031", "src-00032"];
  }
  scenario "detect-model-protocol-request-projection-divergence" {
    capabilityId "verify-model-connection-conformance";
    label "Detect incorrect provider wire projection";
    nodeIds ["s2-input", "s2-event", "s2-outcome"];
    sourceRefs ["src-00033", "src-00034"];
  }
  scenario "detect-model-provider-testimony-normalization-divergence" {
    capabilityId "verify-model-connection-conformance";
    label "Detect incorrect success error refusal truncation or malformed-body mapping";
    nodeIds ["s3-input", "s3-event", "s3-outcome"];
    sourceRefs ["src-00035", "src-00036"];
