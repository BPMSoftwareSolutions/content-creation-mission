  capability "publish-sidefx-evidence-receipt" {
    label "Publish one admitted SideFX evidence receipt to the durable store";
    domain "Frozen source corpus";
    scenarioIds ["publish-sidefx-evidence-receipt", "republish-sidefx-evidence-receipt-idempotently", "reject-conflicting-sidefx-evidence-receipt-publication", "bind-terminal-sidefx-publication-testimony"];
    coverage "4 declared scenarios; native detail remains separately inspectable";
    sourceRefs ["src-00000"];
  }
  scenario "publish-sidefx-evidence-receipt" {
    capabilityId "publish-sidefx-evidence-receipt";
    label "Publish one admitted receipt at its exact content address";
    nodeIds ["s0-input", "s0-event", "s0-outcome"];
    sourceRefs ["src-00014", "src-00015"];
  }
  scenario "republish-sidefx-evidence-receipt-idempotently" {
    capabilityId "publish-sidefx-evidence-receipt";
    label "Report an idempotent exact republish without another write";
    nodeIds ["s1-input", "s1-event", "s1-outcome"];
    sourceRefs ["src-00016", "src-00017"];
  }
  scenario "reject-conflicting-sidefx-evidence-receipt-publication" {
    capabilityId "publish-sidefx-evidence-receipt";
    label "Refuse an unverified digest or an occupied-address conflict before any write";
    nodeIds ["s2-input", "s2-event", "s2-outcome"];
    sourceRefs ["src-00018", "src-00019"];
  }
  scenario "bind-terminal-sidefx-publication-testimony" {
    capabilityId "publish-sidefx-evidence-receipt";
    label "Bind terminal publication testimony outside the receipt digest basis";
    nodeIds ["s3-input", "s3-event", "s3-outcome"];
    sourceRefs ["src-00020", "src-00021"];
  }
  input "s0-input" {
    label "sidefx evidence receipt publication record";
