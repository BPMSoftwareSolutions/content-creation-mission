  capability "operate-capsule-estate" {
    label "Operate the SideFX capsule estate";
    domain "Frozen source corpus";
    scenarioIds ["operate-capsule-estate", "verify-capsule-estate", "resolve-capsule-estate-dependencies", "discover-and-inspect-capsules", "execute-capsule-carried-capabilities", "reconstruct-and-project-capsule-estate", "prove-capsule-first-checkout-closure"];
    coverage "7 declared scenarios; native detail remains separately inspectable";
    sourceRefs ["src-00000"];
  }
  scenario "operate-capsule-estate" {
    capabilityId "operate-capsule-estate";
    label "Dispatch one admitted capsule estate operation";
    nodeIds ["s0-input", "s0-event", "s0-outcome"];
    sourceRefs ["src-00173", "src-00174"];
  }
  scenario "verify-capsule-estate" {
    capabilityId "operate-capsule-estate";
    label "Verify the complete capsule-only estate";
    nodeIds ["s1-input", "s1-event", "s1-outcome"];
    sourceRefs ["src-00175", "src-00176"];
  }
  scenario "resolve-capsule-estate-dependencies" {
    capabilityId "operate-capsule-estate";
    label "Resolve only declared capsule dependencies and tool roots";
    nodeIds ["s2-input", "s2-event", "s2-outcome"];
    sourceRefs ["src-00177", "src-00178"];
  }
  scenario "discover-and-inspect-capsules" {
    capabilityId "operate-capsule-estate";
    label "List and inspect admitted capsules";
    nodeIds ["s3-input", "s3-event", "s3-outcome"];
    sourceRefs ["src-00179", "src-00180"];
  }
  scenario "execute-capsule-carried-capabilities" {
    capabilityId "operate-capsule-estate";
    label "Invoke one capsule or prove selected fixtures directly";
    nodeIds ["s4-input", "s4-event", "s4-outcome"];
    sourceRefs ["src-00181", "src-00182"];
  }
  scenario "reconstruct-and-project-capsule-estate" {
    capabilityId "operate-capsule-estate";
    label "Reconstruct and project into an explicitly selected disposable root";
    nodeIds ["s5-input", "s5-event", "s5-outcome"];
    sourceRefs ["src-00183", "src-00184"];
  }
  scenario "prove-capsule-first-checkout-closure" {
    capabilityId "operate-capsule-estate";
    label "Prove capsule-first closure from an owned sterile checkout";
    nodeIds ["s6-input", "s6-event", "s6-outcome"];
    sourceRefs ["src-00185", "src-00186"];
  }
  input "s0-input" {
    label "capsule estate operation request";
    detail "one operation from verify, resolve, list, inspect, invoke, expand, project, prove-direct-execution, prove-capsule-first, or prove-sterile-checkout with a cal…";
    capabilityId "operate-capsule-estate";
    scenarioId "operate-capsule-estate";
    basis "DECLARED";
    sourceRefs ["src-00173", "src-00174"];
    layer "mechanic";
    productContract "capsule-estate-operation-request.v2";
  }
  event "s0-event" {
    label "capsule estate operation requested";
    detail "the capsule estate operation is requested";
    capabilityId "operate-capsule-estate";
    scenarioId "operate-capsule-estate";
    basis "DECLARED";
    sourceRefs ["src-00173", "src-00174"];
    layer "mechanic";
  }
