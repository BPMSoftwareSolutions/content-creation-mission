  capability "write-binary-artifact" {
    label "Write binary artifact from the exact parent carrier through the admitted bounded filesystem store";
    domain "Frozen source corpus";
    scenarioIds ["write-binary-artifact", "validate-binary-artifact-write-request", "observe-binary-artifact-write-result", "verify-binary-artifact-readback"];
    coverage "4 declared scenarios; native detail remains separately inspectable";
    sourceRefs ["src-00000"];
  }
  scenario "write-binary-artifact" {
    capabilityId "write-binary-artifact";
    label "Write and verify the successor parent-produced complete WAV request";
    nodeIds ["s0-input", "s0-event", "s0-outcome"];
    sourceRefs ["src-00262", "src-00263"];
  }
  scenario "validate-binary-artifact-write-request" {
    capabilityId "write-binary-artifact";
    label "Validate the request before any physical effect";
    nodeIds ["s1-input", "s1-event", "s1-outcome"];
    sourceRefs ["src-00264", "src-00265"];
  }
  scenario "observe-binary-artifact-write-result" {
    capabilityId "write-binary-artifact";
    label "Observe the bounded filesystem write result before read-back";
    nodeIds ["s2-input", "s2-event", "s2-outcome"];
    sourceRefs ["src-00266", "src-00267"];
  }
  scenario "verify-binary-artifact-readback" {
    capabilityId "write-binary-artifact";
    label "Verify one physical artifact read-back";
    nodeIds ["s3-input", "s3-event", "s3-outcome"];
    sourceRefs ["src-00268", "src-00269"];
  }
  input "s0-input" {
    label "binary artifact write request";
    detail "the successor parent request {contractId: binary-artifact-write-request.v1, payload: {encoding: base64, bytesBase64: complete WAV carrier}}";
    capabilityId "write-binary-artifact";
    scenarioId "write-binary-artifact";
    basis "DECLARED";
    sourceRefs ["src-00262", "src-00263"];
    layer "mechanic";
    productContract "binary-artifact-write-request.v1";
  }
  event "s0-event" {
    label "materialize governed artifact";
    detail "pre-effect validation accepts the carrier and the admitted sda-filesystem-artifact-store.v1 stages a bounded write and atomically renames it";
    capabilityId "write-binary-artifact";
    scenarioId "write-binary-artifact";
    basis "DECLARED";
    sourceRefs ["src-00262", "src-00263"];
    layer "mechanic";
  }
  outcome "s0-outcome" {
    label "binary artifact write outcome";
    detail "derive a bounded destination from the decoded-byte SHA-256, read the destination bytes, and require byte length and SHA-256 equality before SUCCEEDED";
    capabilityId "write-binary-artifact";
    scenarioId "write-binary-artifact";
    basis "DECLARED";
    sourceRefs ["src-00262", "src-00263"];
    layer "mechanic";
    productContract "binary-artifact-write-outcome.v2";
  }
  input "s1-input" {
    label "binary artifact write request";
    detail "a request whose encoding, base64 syntax, bounded destination safety, and collision policy can be checked without writing";
    capabilityId "write-binary-artifact";
    scenarioId "validate-binary-artifact-write-request";
    basis "DECLARED";
    sourceRefs ["src-00264", "src-00265"];
    layer "mechanic";
    productContract "binary-artifact-write-request.v1";
  }
  event "s1-event" {
    label "validate binary artifact write request";
    detail "the pre-effect validation boundary evaluates the request";
    capabilityId "write-binary-artifact";
    scenarioId "validate-binary-artifact-write-request";
    basis "DECLARED";
    sourceRefs ["src-00264", "src-00265"];
    layer "mechanic";
  }
  outcome "s1-outcome" {
    label "binary artifact write validation";
    detail "ACCEPTED proceeds to the provider or REJECTED terminates without filesystem descent";
    capabilityId "write-binary-artifact";
    scenarioId "validate-binary-artifact-write-request";
    basis "DECLARED";
    sourceRefs ["src-00264", "src-00265"];
    layer "mechanic";
    productContract "binary-artifact-write-validation.v1";
  }
  input "s2-input" {
    label "binary artifact write observation";
    detail "one admitted filesystem write attempt and its bounded write receipt";
    capabilityId "write-binary-artifact";
    scenarioId "observe-binary-artifact-write-result";
    basis "DECLARED";
    sourceRefs ["src-00266", "src-00267"];
    layer "mechanic";
    productContract "binary-artifact-write-observation.v1";
  }
  event "s2-event" {
    label "observe binary artifact write result";
    detail "the write effect returns to the capability evidence boundary";
    capabilityId "write-binary-artifact";
    scenarioId "observe-binary-artifact-write-result";
    basis "DECLARED";
    sourceRefs ["src-00266", "src-00267"];
    layer "mechanic";
  }
  outcome "s2-outcome" {
    label "binary artifact write result";
    detail "WRITE_ESTABLISHED alone may descend to read-back, while WRITE_FAILED or HELD terminate locally";
    capabilityId "write-binary-artifact";
    scenarioId "observe-binary-artifact-write-result";
    basis "DECLARED";
    sourceRefs ["src-00266", "src-00267"];
    layer "mechanic";
    productContract "binary-artifact-write-result.v1";
  }
  input "s3-input" {
    label "binary artifact readback observation";
    detail "one bounded write effect and one physical byte read-back observation";
    capabilityId "write-binary-artifact";
    scenarioId "verify-binary-artifact-readback";
    basis "DECLARED";
    sourceRefs ["src-00268", "src-00269"];
    layer "mechanic";
    productContract "binary-artifact-readback-observation.v2";
  }
  event "s3-event" {
    label "verify binary artifact readback";
    detail "decoded-byte length and SHA-256 are compared with the candidate expectation";
    capabilityId "write-binary-artifact";
    scenarioId "verify-binary-artifact-readback";
    basis "DECLARED";
    sourceRefs ["src-00268", "src-00269"];
    layer "mechanic";
  }
  outcome "s3-outcome" {
    label "binary artifact write outcome";
    detail "SUCCEEDED or HELD is selected by the declared read-back evidence";
    capabilityId "write-binary-artifact";
    scenarioId "verify-binary-artifact-readback";
    basis "DECLARED";
    sourceRefs ["src-00268", "src-00269"];
    layer "mechanic";
    productContract "binary-artifact-write-outcome.v2";
  }
  route "s0-e0" {
    source "s0-input";
    target "s0-event";
    type "transition";
    label "declared boundary";
    basis "DECLARED";
    sourceRefs ["src-00262", "src-00263"];
  }
