  capability "obtain-governed-model-response" {
    label "Obtain one governed model response as untrusted testimony";
    domain "Frozen source corpus";
    scenarioIds ["obtain-governed-model-response", "resolve-model-alias-embodiment", "project-model-response-policy-to-provider-protocol", "obtain-governed-provider-testimony", "establish-governed-model-response-evidence"];
    coverage "5 declared scenarios; native detail remains separately inspectable";
    sourceRefs ["src-00000"];
  }
  scenario "obtain-governed-model-response" {
    capabilityId "obtain-governed-model-response";
    label "Obtain one policy-bounded model response";
    nodeIds ["s0-input", "s0-event", "s0-outcome"];
    sourceRefs ["src-00038", "src-00039"];
