  promise "{\"experienceId\": \"promised-experience.v1\", \"actor\": \"downstream-authoring-capability\", \"promise\": \"one governed request produces exact model testimony or an attributable failure disposition\", \"observableConditions\": [{\"conditionId\": \"model-request-is-policy-bounded\"}, {\"conditionId\": \"response-testimony-is-attributable\"}, {\"conditionId\": \"failure-disposition-is-exact\"}, {\"conditionId\": \"credentials-remain-external\"}, {\"conditionId\": \"acceptance-authority-remains-separate\"}]}";
