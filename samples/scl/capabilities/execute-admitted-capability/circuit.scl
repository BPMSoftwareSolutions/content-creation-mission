  capability "execute-admitted-capability" {
    label "Execute one admitted capability realization for one scenario input";
    domain "Frozen source corpus";
    scenarioIds ["execute-admitted-capability", "admit-scenario-input", "execute-declared-graph", "admit-outcome-and-emit-testimony", "bind-execution-receipt"];
    coverage "5 declared scenarios; native detail remains separately inspectable";
    sourceRefs ["src-00000"];
  }
  scenario "execute-admitted-capability" {
    capabilityId "execute-admitted-capability";
    label "Execute one realization for one scenario input";
    nodeIds ["s0-input", "s0-event", "s0-outcome"];
    sourceRefs ["src-00017", "src-00018"];
  }
  scenario "admit-scenario-input" {
    capabilityId "execute-admitted-capability";
    label "Admit the scenario input against the declared contract";
    nodeIds ["s1-input", "s1-event", "s1-outcome"];
    sourceRefs ["src-00019", "src-00020"];
  }
  scenario "execute-declared-graph" {
    capabilityId "execute-admitted-capability";
    label "Execute the declared graph for the admitted input";
    nodeIds ["s2-input", "s2-event", "s2-outcome"];
    sourceRefs ["src-00021", "src-00022"];
  }
  scenario "admit-outcome-and-emit-testimony" {
    capabilityId "execute-admitted-capability";
    label "Admit the observed outcome and emit bound testimony";
    nodeIds ["s3-input", "s3-event", "s3-outcome"];
    sourceRefs ["src-00023", "src-00024"];
  }
  scenario "bind-execution-receipt" {
    capabilityId "execute-admitted-capability";
    label "Bind one replayable execution receipt";
    nodeIds ["s4-input", "s4-event", "s4-outcome"];
    sourceRefs ["src-00025", "src-00026"];
  }
  input "s0-input" {
    label "capability execution record";
    detail "one conforming realization digest, one scenario identity, and one scenario input";
    capabilityId "execute-admitted-capability";
    scenarioId "execute-admitted-capability";
    basis "DECLARED";
    sourceRefs ["src-00017", "src-00018"];
    layer "mechanic";
    productContract "capability-execution-record.v1";
  }
  event "s0-event" {
    label "capability execution requested";
    detail "the capability is executed";
    capabilityId "execute-admitted-capability";
    scenarioId "execute-admitted-capability";
    basis "DECLARED";
    sourceRefs ["src-00017", "src-00018"];
    layer "mechanic";
  }
  outcome "s0-outcome" {
    label "capability execution record";
    detail "the effect is established or a governed disposition is returned, and the execution receipt binds realization, scenario, input, outcome, and disposition";
    capabilityId "execute-admitted-capability";
    scenarioId "execute-admitted-capability";
    basis "DECLARED";
    sourceRefs ["src-00017", "src-00018"];
    layer "mechanic";
    productContract "capability-execution-record.v1";
  }
  input "s1-input" {
