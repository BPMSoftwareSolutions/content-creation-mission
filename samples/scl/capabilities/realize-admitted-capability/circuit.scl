circuit "realize-admitted-capability" {
  title "Realize one admitted capability capsule for one environment";
  promise "{\"experienceType\": \"promised-experience.v1\", \"experienceId\": \"realize-admitted-capability-is-environment-bound\", \"actor\": \"capability deployer\", \"promise\": \"The projected capability returns one conformant realization or a typed held disposition; the capability digest never changes while the realization digest differs by environment.\", \"observableConditions\": [{\"conditionId\": \"providers-resolved\", \"statement\": \"every required provider resolves in the available catalog for the declared target\"}, {\"conditionId\": \"identity-preserved\", \"statement\": \"the realized graph digest equals the canonical graph digest\"}, {\"conditionId\": \"dimensions-closed\", \"statement\": \"all seven conformance dimensions pass\"}]}";
