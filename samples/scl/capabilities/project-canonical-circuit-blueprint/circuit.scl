  capability "project-canonical-circuit-blueprint" {
    label "Project one canonical circuit blueprint";
    domain "Frozen source corpus";
    scenarioIds ["project-canonical-circuit-blueprint", "resolve-canonical-circuit-blueprint", "project-canonical-circuit-blueprint-ascii", "project-canonical-circuit-blueprint-mermaid", "project-declared-blueprint-lenses", "compose-canonical-blueprint-review-document", "verify-canonical-blueprint-review-document", "verify-canonical-circuit-blueprint-replay", "bind-canonical-circuit-blueprint-projection-receipt"];
    coverage "9 declared scenarios; native detail remains separately inspectable";
    sourceRefs ["src-00000"];
  }
  scenario "project-canonical-circuit-blueprint" {
    capabilityId "project-canonical-circuit-blueprint";
    label "Project every declared view from one carrier and bind its replay receipt";
    nodeIds ["s0-input", "s0-event", "s0-outcome"];
    sourceRefs ["src-00030", "src-00031"];
  }
  scenario "resolve-canonical-circuit-blueprint" {
    capabilityId "project-canonical-circuit-blueprint";
    label "Construct one normalized carrier preserving partial order separately from ordinals";
    nodeIds ["s1-input", "s1-event", "s1-outcome"];
    sourceRefs ["src-00032", "src-00033"];
  }
  scenario "project-canonical-circuit-blueprint-ascii" {
