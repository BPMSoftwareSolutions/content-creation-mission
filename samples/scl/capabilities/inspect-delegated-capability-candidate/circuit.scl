  capability "inspect-delegated-capability-candidate" {
    label "Inspect one delegated capability candidate before source materialization";
    domain "Frozen source corpus";
    scenarioIds ["inspect-delegated-capability-candidate", "observe-delegated-candidate-inspection-inputs", "derive-feature-derived-candidate-slot-scope", "inspect-declarative-candidate-artifact-slots", "resolve-declarative-candidate-slot-disposition"];
    coverage "5 declared scenarios; native detail remains separately inspectable";
    sourceRefs ["src-00000"];
  }
  scenario "inspect-delegated-capability-candidate" {
    capabilityId "inspect-delegated-capability-candidate";
    label "Return deterministic candidate-slot inspection evidence";
    nodeIds ["s0-input", "s0-event", "s0-outcome"];
    sourceRefs ["src-00018", "src-00019"];
  }
  scenario "observe-delegated-candidate-inspection-inputs" {
    capabilityId "inspect-delegated-capability-candidate";
    label "Observe immutable feature, response, and profile evidence";
