circuit "manage-capsule-estate" {
  title "Operate a capsule estate from bootstrap authority";
  promise "{\"experienceId\": \"manage-capsule-estate.v1\", \"actor\": \"a capsule-estate operator\", \"promise\": \"every admitted capsule-estate command completes through its exact governed scenario or returns attributable rejection\", \"observableConditions\": [{\"conditionId\": \"verify-capsule-estate-closes\"}, {\"conditionId\": \"resolve-capsule-dependencies-and-tool-roots-closes\"}, {\"conditionId\": \"list-eligible-capsules-closes\"}, {\"conditionId\": \"inspect-one-capsule-closes\"}, {\"conditionId\": \"prove-direct-execution-closes\"}, {\"conditionId\": \"invoke-one-capability-closes\"}, {\"conditionId\": \"expand-the-capsule-estate-closes\"}, {\"conditionId\": \"project-the-capsule-estate-closes\"}, {\"conditionId\": \"prove-capsule-first-operation-closes\"}, {\"conditionId\": \"run-the-sterile-proof-closes\"}, {\"conditionId\": \"migrate-the-legacy-capsule-estate-closes\"}]}";
