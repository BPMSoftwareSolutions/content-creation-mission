  outcome "s2-outcome" {
    label "human blueprint review testimony admission";
    detail "exact approve, hold, or reject testimony is admitted immutably, while mismatched reviewer authority, changed surfaces, an undeclared disposition, or hold or …";
    capabilityId "bind-canonical-blueprint-review";
    scenarioId "admit-human-blueprint-review-testimony";
