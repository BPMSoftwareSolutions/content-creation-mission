  }
  scenario "admit-human-blueprint-review-testimony" {
    capabilityId "bind-canonical-blueprint-review";
    label "Admit only testimony supplied by the designated reviewer for the exact boundary";
    nodeIds ["s2-input", "s2-event", "s2-outcome"];
    sourceRefs ["src-00026", "src-00027"];
  }
  scenario "bind-blueprint-review-disposition" {
    capabilityId "bind-canonical-blueprint-review";
    label "Bind the exact valid decision without changing its meaning";
    nodeIds ["s3-input", "s3-event", "s3-outcome"];
    sourceRefs ["src-00028", "src-00029"];
  }
  scenario "verify-blueprint-review-digest-closure" {
    capabilityId "bind-canonical-blueprint-review";
    label "Emit a receipt only while every submitted digest closes against the admitted byte boundary";
    nodeIds ["s4-input", "s4-event", "s4-outcome"];
    sourceRefs ["src-00030", "src-00031"];
  }
  input "s0-input" {
    label "canonical blueprint review binding request";
