  capability "bind-canonical-blueprint-review" {
    label "Bind one canonical blueprint review";
    domain "Frozen source corpus";
    scenarioIds ["bind-canonical-blueprint-review", "admit-blueprint-review-boundary", "admit-human-blueprint-review-testimony", "bind-blueprint-review-disposition", "verify-blueprint-review-digest-closure"];
    coverage "5 declared scenarios; native detail remains separately inspectable";
    sourceRefs ["src-00000"];
  }
  scenario "bind-canonical-blueprint-review" {
    capabilityId "bind-canonical-blueprint-review";
    label "Bind submitted human review testimony to the exact review boundary";
    nodeIds ["s0-input", "s0-event", "s0-outcome"];
    sourceRefs ["src-00022", "src-00023"];
  }
  scenario "admit-blueprint-review-boundary" {
    capabilityId "bind-canonical-blueprint-review";
    label "Admit only a complete and current review boundary";
    nodeIds ["s1-input", "s1-event", "s1-outcome"];
