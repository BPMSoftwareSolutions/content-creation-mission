    layer "mechanic";
    productContract "canonical-blueprint-review-binding-request.v2";
  }
  event "s1-event" {
    label "admit blueprint review boundary";
    detail "every byte digest is recomputed, each JSON carrier is parsed without exception, and the claimed boundary is resolved against the carried blueprint and projec…";
