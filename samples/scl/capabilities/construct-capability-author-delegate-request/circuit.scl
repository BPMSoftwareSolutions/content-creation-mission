  promise "{\"experienceId\": \"promised-experience.v1\", \"actor\": \"downstream-capability-author\", \"promise\": \"a reviewed feature and governed profile become one deterministic, hash-bound delegate request\", \"observableConditions\": [{\"conditionId\": \"feature-is-observed-unchanged\"}, {\"conditionId\": \"authoring-profile-is-closed\"}, {\"conditionId\": \"delegate-request-is-schema-valid\"}, {\"conditionId\": \"publication-is-atomic-and-hash-bound\"}, {\"conditionId\": \"next-operation-receives-unchanged-request\"}, {\"conditionId\": \"model-is-not-invoked\"}, {\"conditionId\": \"acceptance-authority-remains-separate\"}]}";
