scl "0.1";
circuit "verify-sidefx-durable-store-admission" {
  title "Verify SideFX durable store admission";
  promise "{\"experienceType\": \"promised-experience.v1\", \"experienceId\": \"sidefx-durable-store-admission-is-observable\", \"actor\": \"SideFX semantic authority maintainer\", \"promise\": \"Every declared durable-store document is admitted or refused by admitted mechanics, declared agreement across documents is evaluated, and each admitted receipt reproduces its own digest, without any hand-authored instrument and without implying provider conformance.\", \"observableConditions\": [{\"conditionId\": \"document-admission-is-visible\", \"statement\": \"the schema admission disposition of every declared document is observable\"}, {\"conditionId\": \"refusal-names-its-law\", \"statement\": \"a refused document names the dominant diagnostic and the law it violates\"}, {\"conditionId\": \"declared-agreement-is-visible\", \"statement\": \"agreement across the admitted store documents is observable as a typed disposition\"}, {\"conditionId\": \"receipt-digests-reproduce\", \"statement\": \"each admitted store receipt digest is recomputed from its own canonical bytes\"}, {\"conditionId\": \"absence-is-distinct-from-rejection\", \"statement\": \"an unobservable document is reported as not observable and never as an integrity rejection\"}]}";
  status "SOURCE_REVEAL";
  sourceGeneration "0b02db7ee691898d499cb9046737dce3f7c34aa8e1e3d6ca4908afeb823fb802";
