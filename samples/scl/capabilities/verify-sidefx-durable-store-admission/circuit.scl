  capability "verify-sidefx-durable-store-admission" {
    label "Verify SideFX durable store admission";
    domain "Frozen source corpus";
    scenarioIds ["verify-sidefx-durable-store-admission", "admit-declared-store-law-document", "refuse-adversarial-store-contract-case", "agree-across-admitted-store-documents", "report-absent-store-document-not-observable"];
    coverage "5 declared scenarios; native detail remains separately inspectable";
    sourceRefs ["src-00000"];
  }
  scenario "verify-sidefx-durable-store-admission" {
    capabilityId "verify-sidefx-durable-store-admission";
    label "Observe one admission disposition for the declared durable-store law";
