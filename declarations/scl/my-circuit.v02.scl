scl 0.2;
capability my-capability {
  label "My first circuit";
  promise "Describe the experience this capability should create.";

  scenario happy-path {
    label "The intended experience";
    given request "A request arrives";
    when work {
      label "Make it happen";
      responsibility "What mechanic changes the situation?";
    }
    then result {
      label "The person gets a result";
      experience "What changed for the person?";
    }
  }
}
